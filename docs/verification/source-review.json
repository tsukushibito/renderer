  "reproduction": {
    "harness_source_utf8": "use renderer::engine::{Draw, Engine, IDENTITY, Material, MeshData, Vertex, View};\r\nuse renderer::graph::{BufferDesc, Graph};\r\nuse std::alloc::{GlobalAlloc, Layout, System};\r\nuse std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};\r\n\r\nstruct Counter;\r\nstatic COUNTING: AtomicBool = AtomicBool::new(false);\r\nstatic ALLOCS: AtomicUsize = AtomicUsize::new(0);\r\nstatic BYTES: AtomicUsize = AtomicUsize::new(0);\r\n#[global_allocator]\r\nstatic ALLOCATOR: Counter = Counter;\r\nunsafe impl GlobalAlloc for Counter {\r\n    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {\r\n        if COUNTING.load(Ordering::Relaxed) {\r\n            ALLOCS.fetch_add(1, Ordering::Relaxed);\r\n            BYTES.fetch_add(layout.size(), Ordering::Relaxed);\r\n        }\r\n        unsafe { System.alloc(layout) }\r\n    }\r\n    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {\r\n        unsafe { System.dealloc(pointer, layout) }\r\n    }\r\n    unsafe fn realloc(&self, pointer: *mut u8, layout: Layout, size: usize) -> *mut u8 {\r\n        if COUNTING.load(Ordering::Relaxed) {\r\n            ALLOCS.fetch_add(1, Ordering::Relaxed);\r\n            BYTES.fetch_add(size, Ordering::Relaxed);\r\n        }\r\n        unsafe { System.realloc(pointer, layout, size) }\r\n    }\r\n}\r\nfn measure<T>(f: impl FnOnce() -> T) -> (T, usize, usize) {\r\n    ALLOCS.store(0, Ordering::Relaxed);\r\n    BYTES.store(0, Ordering::Relaxed);\r\n    COUNTING.store(true, Ordering::Relaxed);\r\n    let result = std::hint::black_box(f());\r\n    COUNTING.store(false, Ordering::Relaxed);\r\n    (result, ALLOCS.load(Ordering::Relaxed), BYTES.load(Ordering::Relaxed))\r\n}\r\nfn main() {\r\n    let mut graph = Graph::new();\r\n    for index in 0..2048 {\r\n        let buffer = graph.buffer(format!(\"resource {index}\"), BufferDesc { size: 4 }).unwrap();\r\n        graph.upload_buffer(format!(\"upload {index}\"), buffer, 0, vec![0; 4]).unwrap();\r\n        graph.readback_buffer(format!(\"readback {index}\"), buffer, 0, 4).unwrap();\r\n    }\r\n    let (plan, calls, bytes) = measure(|| graph.compile().unwrap());\r\n    assert_eq!(plan.pass_count(),4096);\r\n    println!(\"compile resources=2048 passes=4096 allocations={calls} allocated_bytes={bytes}\");\r\n    let mut engine = Engine::new(1,1).unwrap();\r\n    let mesh = engine.create_mesh(MeshData::new(&[\r\n        Vertex { position:[-1.0,-1.0,0.5], color:[1.0;4] },\r\n        Vertex { position:[1.0,-1.0,0.5], color:[1.0;4] },\r\n        Vertex { position:[0.0,1.0,0.5], color:[1.0;4] },\r\n    ], &[0,1,2]).unwrap()).unwrap();\r\n    let material=engine.create_material(Material::default()).unwrap();\r\n    let view=View{ width:32,height:32,clip_from_world:IDENTITY,clear_color:[0.0;4] };\r\n    let draws=vec![Draw{mesh,material,world_from_model:IDENTITY};8192];\r\n    let snapshot=engine.snapshot(&view,&draws).unwrap();\r\n    let (frame,calls,bytes)=measure(||snapshot.build_graph(false,|_,color| Ok(color)).unwrap());\r\n    assert_eq!(frame.graph.compile().unwrap().pass_count(),3);\r\n    println!(\"frame_build draws=8192 allocations={calls} allocated_bytes={bytes}\");\r\n}\r\n",
    "manifest_template": "[package]\nname=\"cpu-allocation-probe\"\nversion=\"0.0.0\"\nedition=\"2024\"\npublish=false\n[workspace]\n[dependencies]\nrenderer={path=\"<absolute checkout>/crates/renderer\",default-features=false}\n",
    "instructions": "Use two isolated checkout paths at baseline and patched commits; create one temporary crate per checkout from the identical harness source and manifest template. Run pinned Rust 1.99.0 cargo run --release --offline --manifest-path <probe>/Cargo.toml with CARGO_INCREMENTAL=0. Source hash preserves CRLF. Counters measure allocation/reallocation calls and requested bytes, not retained or peak memory."
  },
