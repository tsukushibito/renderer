#version 450 core
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform texture2D source_image;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D destination_image;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(destination_image)))) {
        return;
    }
    ivec2 source_end = textureSize(source_image, 0) - 1;
    ivec2 first = min(pixel * 2, source_end);
    ivec2 last = min(first + 1, source_end);
    vec3 sum = texelFetch(source_image, first, 0).rgb
             + texelFetch(source_image, ivec2(last.x, first.y), 0).rgb
             + texelFetch(source_image, ivec2(first.x, last.y), 0).rgb
             + texelFetch(source_image, last, 0).rgb;
    imageStore(destination_image, pixel, vec4(sum * 0.25, 0.0));
}
