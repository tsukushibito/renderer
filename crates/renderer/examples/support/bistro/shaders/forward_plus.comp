#version 450 core
#extension GL_GOOGLE_include_directive : require
#include "local_lights.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std140) uniform CullCamera {
    mat4 view_projection;
} camera;
layout(set = 0, binding = 3, std430) writeonly buffer TileLists {
    uint words[];
} tile_lists;

vec4 matrix_row(mat4 m, int row) {
    return vec4(m[0][row], m[1][row], m[2][row], m[3][row]);
}

bool sphere_touches(vec4 plane, vec3 center, float radius) {
    vec4 terms = plane * vec4(center, 1.0);
    float reach = radius * length(plane.xyz);
    // Retain lights at a plane boundary despite normal FP32 evaluation error.
    float tolerance = (dot(abs(terms), vec4(1.0)) + reach + 1.0) * 0.00001;
    return !(dot(terms, vec4(1.0)) < -reach - tolerance);
}

void main() {
    // The reviewed 1D dispatch determines the write address. Untrusted frame
    // dimensions can change membership only, not where or how much we write.
    uint tile = gl_GlobalInvocationID.x;
    uint start = tile * LOCAL_LIGHT_TILE_WORDS;
    uvec2 extent = local_light_extent();
    uint columns = local_light_columns(extent);
    uvec2 tile_xy = uvec2(tile % columns, tile / columns);
    uvec2 first = tile_xy * LOCAL_LIGHT_TILE_SIZE;
    uint count = 0u;
    if (all(lessThan(first, extent))) {
        uvec2 end = min(first + LOCAL_LIGHT_TILE_SIZE, extent);
        vec2 lower = 2.0 * vec2(first) / vec2(extent) - 1.0;
        vec2 upper = 2.0 * vec2(end) / vec2(extent) - 1.0;
        vec4 x = matrix_row(camera.view_projection, 0);
        vec4 y = matrix_row(camera.view_projection, 1);
        vec4 z = matrix_row(camera.view_projection, 2);
        vec4 w = matrix_row(camera.view_projection, 3);
        vec4 left = x - lower.x * w;
        vec4 right = upper.x * w - x;
        vec4 top = y - lower.y * w;
        vec4 bottom = upper.y * w - y;
        vec4 far_plane = w - z;
        uint lights = local_light_count();
        for (uint index = 0u; index < lights; ++index) {
            vec4 sphere = local_lights.lights[index].position_radius;
            if (sphere.w > 0.0
                && sphere_touches(left, sphere.xyz, sphere.w)
                && sphere_touches(right, sphere.xyz, sphere.w)
                && sphere_touches(top, sphere.xyz, sphere.w)
                && sphere_touches(bottom, sphere.xyz, sphere.w)
                && sphere_touches(z, sphere.xyz, sphere.w)
                && sphere_touches(far_plane, sphere.xyz, sphere.w)) {
                tile_lists.words[start + 1u + count] = index;
                ++count;
            }
        }
    }
    for (uint index = count; index < MAX_LOCAL_LIGHTS; ++index) {
        tile_lists.words[start + 1u + index] = 0u;
    }
    tile_lists.words[start] = count;
}
