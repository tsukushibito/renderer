#version 450 core
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform texture2D source_image;
layout(set = 0, binding = 1) uniform texture2D blur_image;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D destination_image;

vec3 blur_at(vec2 coordinate, ivec2 extent) {
    vec2 position = clamp(coordinate, vec2(0.0), vec2(extent - 1));
    ivec2 lower = ivec2(position);
    ivec2 upper = min(lower + 1, extent - 1);
    vec2 fraction = position - vec2(lower);
    vec3 top = mix(texelFetch(blur_image, lower, 0).rgb,
                   texelFetch(blur_image, ivec2(upper.x, lower.y), 0).rgb, fraction.x);
    vec3 bottom = mix(texelFetch(blur_image, ivec2(lower.x, upper.y), 0).rgb,
                      texelFetch(blur_image, upper, 0).rgb, fraction.x);
    return mix(top, bottom, fraction.y);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(destination_image);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    ivec2 blur_extent = textureSize(blur_image, 0);
    vec2 position = (vec2(pixel) + 0.5) * (vec2(blur_extent) / vec2(extent)) - 0.5;
    ivec2 source_end = textureSize(source_image, 0) - 1;
    vec4 color = texelFetch(source_image, min(pixel, source_end), 0);
    vec3 combined = min(color.rgb + blur_at(position, blur_extent) * 0.125, 65504.0);
    imageStore(destination_image, pixel, vec4(combined, color.a));
}
