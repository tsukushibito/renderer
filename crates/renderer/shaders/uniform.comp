#version 450 core

// Trusted ABI fixture: one invocation copies one complete 16-byte uint vector.
// The host dispatches exactly one workgroup, owns both ranges, and keeps their
// immutable binding versions alive through completion. Both buffers use public
// creation/binding contracts; dispatch remains private acceptance infrastructure.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std140) uniform Parameters {
    uvec4 value;
} parameters;
layout(set = 1, binding = 0, std430) writeonly buffer Result {
    uvec4 value;
} result;

void main() {
    result.value = parameters.value;
}
