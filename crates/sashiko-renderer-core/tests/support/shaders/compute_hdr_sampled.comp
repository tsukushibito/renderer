#version 450 core

// Caller-owned reviewed compute fixture. The static Program descriptor binds
// the complete shader ABI and derives workgroups from destination extent.
// All invocations own disjoint output texels; rounded fringe invocations exit.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform texture2D source_image;
layout(set = 0, binding = 1) uniform sampler source_sampler;
layout(set = 0, binding = 2, std140) uniform Parameters {
    vec4 value;
} parameters;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D destination_image;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = imageSize(destination_image);
    if (any(greaterThanEqual(pixel, extent))) {
        return;
    }
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(extent);
    vec4 value = textureLod(sampler2D(source_image, source_sampler), uv, 0.0);
    imageStore(destination_image, pixel, value * parameters.value);
}
