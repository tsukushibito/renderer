#version 450 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer Templates {
    uvec2 ranges[];
} templates;

layout(set = 0, binding = 1, std430) readonly buffer Visibility {
    uint visible[];
} visibility;

// Vulkan and D3D12 use this same five-word layout. The Graph owns the index
// range templates and binds a padded range covering every dispatched slot.
struct IndexedArguments {
    uint index_count;
    uint instance_count;
    uint first_index;
    int base_vertex;
    uint first_instance;
};

layout(set = 0, binding = 2, std430) writeonly buffer Arguments {
    IndexedArguments draws[];
} arguments;

void main() {
    uint slot = gl_GlobalInvocationID.x;
    uvec2 range = templates.ranges[slot];
    uint instances = visibility.visible[slot] != 0u ? 1u : 0u;
    arguments.draws[slot] = IndexedArguments(range.y, instances, range.x, 0, 0u);
}
