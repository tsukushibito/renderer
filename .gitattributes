# Generated Rust is byte-compared with fixed-input regeneration.
/crates/renderer/src/backends/d3d12/bindings.rs text eol=lf
/.beads/hooks/* text eol=lf

# DXIL regeneration hashes configs and byte-compares canonical generated text.
/crates/renderer/shaders/*.json text eol=lf
/crates/renderer/shaders/dxil/*.hlsl text eol=lf
/crates/renderer/shaders/dxil/*.reflection.txt text eol=lf
/crates/renderer/shaders/dxil/*.json text eol=lf

# Bistro source, verified interchange assets, and comparison image.
/assets/bistro/source/*.zip filter=lfs diff=lfs merge=lfs -text
# Preserve upstream text bytes, including its original whitespace.
/assets/bistro/source/*.txt -text -whitespace
/assets/bistro/converted/** filter=lfs diff=lfs merge=lfs -text
/assets/bistro/environment/*.hdr filter=lfs diff=lfs merge=lfs -text
/docs/verification/bistro-*-preview.png filter=lfs diff=lfs merge=lfs -text

# Preserve bytes hashed by the fixed-conditions render record on every OS.
/tools/bistro/conditions.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tools/bistro/*conditions*.py text eol=lf
/docs/verification/bistro-*.json text eol=lf
