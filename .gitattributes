# Generated Rust is byte-compared with fixed-input regeneration.
/crates/sashiko-renderer-core/src/backends/d3d12/bindings.rs text eol=lf
/.beads/hooks/* text eol=lf

# Browser shader text is byte-compared with reproducible regeneration.
*.wgsl text eol=lf

# DXIL regeneration hashes configs and byte-compares canonical generated text.
/crates/sashiko-renderer-core/shaders/*.json text eol=lf
/crates/sashiko-renderer-core/shaders/dxil/*.hlsl text eol=lf
/crates/sashiko-renderer-core/shaders/dxil/*.reflection.txt text eol=lf
/crates/sashiko-renderer-core/shaders/dxil/*.json text eol=lf
/crates/sashiko-renderer-core/fixtures/shaders/dxil/*.hlsl text eol=lf
/crates/sashiko-renderer-core/fixtures/shaders/dxil/*.reflection.txt text eol=lf
/crates/sashiko-renderer-core/tests/support/shaders/dxil/*.hlsl text eol=lf
/crates/sashiko-renderer-core/tests/support/shaders/dxil/*.reflection.txt text eol=lf
/crates/sashiko-renderer-core/tests/support/shaders/dxil/*.json text eol=lf
/crates/sashiko-renderer-core/tests/support/shaders/*-manifest.json text eol=lf
/crates/sashiko-lighting-bake/shaders/*.hlsl text eol=lf
/crates/sashiko-lighting-bake/shaders/*.hlsli text eol=lf
/crates/sashiko-lighting-bake/shaders/dxil/*.reflection.txt text eol=lf
/crates/sashiko-lighting-bake/shaders/dxil/*.json text eol=lf
/crates/sashiko-lighting-bake/shaders/manifest.json text eol=lf
/crates/sashiko-renderer/shaders/*.hlsl text eol=lf
/crates/sashiko-renderer/shaders/*.hlsli text eol=lf
/crates/sashiko-renderer/shaders/dxil/*.reflection.txt text eol=lf
/crates/sashiko-renderer/shaders/dxil/*.json text eol=lf
/crates/sashiko-renderer/shaders/manifest.json text eol=lf
/crates/sashiko-renderer/shaders/output/dxil/*.hlsl text eol=lf
/crates/sashiko-renderer/shaders/output/dxil/*.reflection.txt text eol=lf
/crates/sashiko-renderer/shaders/output/dxil/*.json text eol=lf
/crates/sashiko-renderer/shaders/output/dxil/*.dxil binary

# Bistro source, verified interchange assets, and comparison image.
/assets/bistro/source/*.zip filter=lfs diff=lfs merge=lfs -text
# Preserve upstream text bytes, including its original whitespace.
/assets/bistro/source/*.txt -text -whitespace
/assets/bistro/converted/** filter=lfs diff=lfs merge=lfs -text
/assets/bistro/environment/*.hdr filter=lfs diff=lfs merge=lfs -text
/docs/verification/bistro-*-preview.png filter=lfs diff=lfs merge=lfs -text

# Preserve bytes hashed by the fixed-conditions render record on every OS.
/tools/bistro/conditions.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/tools/bistro/*conditions*.py text eol=lf
/tools/bistro/cook.py text eol=lf
/tools/bistro/mikk.py text eol=lf
# Vendored upstream byte hashes and original license/whitespace are preserved.
/tools/bistro/mikktspace/mikktspace.[ch] -text -whitespace linguist-vendored=true
/tools/bistro/mikktspace/bridge.c text eol=lf
/tools/godot_bistro/cpu_clock/vendor/* -text -whitespace linguist-vendored=true
/docs/verification/bistro-*.json text eol=lf

# The documentation bundle, license and digest are reproduced byte-for-byte.
/docs/theme/vendor/* text eol=lf
# Upstream template-literal whitespace is content; verify the reproduced digest.
/docs/theme/vendor/mermaid.min.js -whitespace linguist-vendored=true

# Keep equipment fixture inputs reproducible.
/examples/training-yard/assets/equipment/source/*.gltf text eol=lf
/examples/training-yard/assets/equipment/source/*.json text eol=lf
/examples/training-yard/assets/equipment/source/*.bin binary
/examples/training-yard/assets/equipment/source/*.png binary

/assets/verification/*-evidence.zip filter=lfs diff=lfs merge=lfs -text

# Cooked texels and joint palettes have byte-exact sizes and content.
/assets/survivor/environment/*.rgba binary
/assets/survivor/characters/*.rgba binary
/assets/survivor/characters/*.skin binary

# Prepared outdoor sample packaged with its glTF attribution.
/assets/landscape/overview.zip filter=lfs diff=lfs merge=lfs -text
