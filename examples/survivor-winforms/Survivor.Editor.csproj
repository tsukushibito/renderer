<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
    <CargoTargetDir Condition="'$(CargoTargetDir)' == ''">$(RepoRoot)target</CargoTargetDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../hosts/winforms/Sashiko.WinForms.csproj" />
    <Content Include="../../assets/survivor/characters/*" Link="assets/survivor/characters/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(CargoTargetDir)/release/survivor.dll" Link="survivor.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildGame" BeforeTargets="PrepareForBuild">
    <Exec WorkingDirectory="$(RepoRoot)" Command="cargo rustc --crate-type cdylib --locked --release -p survivor --lib --no-default-features --features embed,presentation,d3d12 --target-dir &quot;$(CargoTargetDir)&quot;" />
  </Target>
</Project>
